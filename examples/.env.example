# TG Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_CHAT_ID=
# Forum topic thread ids. How to get:
# 1. @BotFather -> your bot -> Bot Settings -> Group Privacy -> Turn off
# 2. In each topic, send the topic name as message (e.g. sonar, freqtrade)
# 3. Run: cargo run --example telegram_discover_topics
# 4. Paste output into this file
TELEGRAM_TOPIC_SONAR=
TELEGRAM_TOPIC_FREQTRADE=
# Send test: cargo run --example telegram_topic -- --thread-id 6

# RPCs
BSC_MAINNET_HTTP_RPC=

# bloXroute config
BLOXROUTE_AUTH_HEADER=
PRIVATE_KEY=

# Etherscan
ETHERSCAN_API_KEY=